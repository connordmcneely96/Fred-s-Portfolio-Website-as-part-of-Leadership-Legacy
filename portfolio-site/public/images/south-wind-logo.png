<svg width="800" height="800" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00B8E6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0066FF;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="800" fill="#1A1F2E"/>
  <rect x="200" y="200" width="400" height="400" fill="url(#grad1)" opacity="0.2"/>
  <text x="400" y="400" font-family="Arial, sans-serif" font-size="48" fill="#00B8E6" text-anchor="middle" dominant-baseline="middle">Portfolio Image</text>
  <text x="400" y="450" font-family="Arial, sans-serif" font-size="24" fill="#A8B2C1" text-anchor="middle" dominant-baseline="middle">800 x 800</text>
</svg>
